# Application Settings
PROJECT_NAME="AI Smart Opportunity Matcher"
API_V1_STR="/api"
SECRET_KEY="super-secret-jwt-key-for-development-change-in-production-ai-opportunity-matcher"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses local SQLite for instant zero-configuration setup.
# To use PostgreSQL, set: DATABASE_URL=postgresql://postgres:password@localhost:5432/opportunity_matcher
DATABASE_URL="sqlite:///./opportunity_matcher.db"

# CORS Configuration (comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
